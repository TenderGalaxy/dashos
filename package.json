{
    "type": "module",
    "dependencies": {
        "esbuild": "^0.28.2",
        "sharp": "^0.35.3"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    },
    "scripts": {
        "esbuild": "esbuild ./src/wc.ts --bundle --format=esm --tree-shaking=false --outfile=dist/wc.js && esbuild ./src/cb.ts --sourcemap --format=esm --tree-shaking=false --outfile=dist/cb.js",
        "build": "node ./virtual/bloxd/parseTextures.ts && tsc && npm run esbuild && node virtual/runTests.ts"
    },
    "sideEffects": [
        "**/*"
    ],
    "devDependencies": {
        "@types/node": "^26.2.0",
        "typescript": "^7.0.2"
    }
}
