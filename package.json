{
  "type": "module",
  "dependencies": {
    "esbuild": "^0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "scripts": {
    "esbuild": "esbuild ./src/wc.ts --bundle --format=esm --tree-shaking=false --outfile=dist/wc.js && esbuild ./src/cb.ts --sourcemap --format=esm --tree-shaking=false --outfile=dist/cb.js",
    "build": "tsc && npm run esbuild && node testing/runTests.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "sideEffects": [
    "**/*"
  ]
}
