{
    "compilerOptions": {
        "target": "esnext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "skipLibCheck": true,
        "types": ["node"],
        "noEmit": true,
        "allowImportingTsExtensions": true
    }
}

